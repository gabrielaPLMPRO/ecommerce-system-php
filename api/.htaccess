RewriteEngine On

# Todas as URLs abaixo serão redirecionadas para pedidoApi.php

# /api/pedido/ → chama pedidoApi.php sem parâmetros (lista tudo)
RewriteRule ^$ pedidoApi.php [NC,L]

# /api/pedido/123 → chama pedidoApi.php?numero=123
RewriteRule ^([0-9]+)/?$ pedidoApi.php?numero=$1 [NC,L]

# /api/pedido/nome/joao → chama pedidoApi.php?nome=joao
RewriteRule ^nome/([^/]+)/?$ pedidoApi.php?nome=$1 [NC,L]

# /api/pedido/123/nome/joao → chama pedidoApi.php?numero=123&nome=joao
RewriteRule ^([0-9]+)/nome/([^/]+)/?$ pedidoApi.php?numero=$1&nome=$2 [NC,L]